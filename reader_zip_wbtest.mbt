///|
test "ZIP reader actual LibreOfficeDev deflate and descriptors" {
  let xml = read_ods_content(zip_libreoffice_fixture)
  assert_true(xml.contains("office:document-content"))
  assert_true(xml.contains("table:table"))
}

///|
test "ZIP reader forged deflate size cannot bypass actual inflate budget" {
  let compressed = @flate.deflate_all(Bytes::make(4194305, b'a'))
  let original = stored_package([
    ("mimetype", @utf8.encode(media_type[:])),
    ("content.xml", compressed),
  ])
  let cd = ods_zip_size(original, original.length() - 6)
  let second_cd = cd + 46 + 8
  let second_local = ods_zip_size(original, second_cd + 42)
  let a = zip_patch(original, second_cd + 10, 8, 2)
  let b = zip_patch(a, second_local + 8, 8, 2)
  let c = zip_patch(b, second_cd + 24, 1, 4)
  let forged = zip_patch(c, second_local + 22, 1, 4)
  assert_true(
    try {
      read_ods_content(forged) |> ignore
      false
    } catch {
      Invalid(message) => message == "ODS exceeds 4 MiB inflated budget"
    },
  )
}

///|
test "ZIP reader validates descriptors and all unused entry CRCs" {
  let source = zip_libreoffice_fixture
  let cd = ods_zip_size(source, source.length() - 6)
  let mut p = cd
  let mut tested = false
  for _ in 0..<ods_zip_u16(source, source.length() - 12) {
    let n = ods_zip_u16(source, p + 28)
    let name = ods_zip_utf8(source[p + 46:p + 46 + n].to_owned())
    if name == "styles.xml" {
      let start = ods_zip_size(source, p + 42)
      let body = start +
        30 +
        ods_zip_u16(source, start + 26) +
        ods_zip_u16(source, start + 28)
      let descriptor = body + ods_zip_size(source, p + 20)
      assert_true(zip_rejects(zip_patch(source, descriptor + 4, 123, 4)))
      // Consistent metadata CRC forgery still fails against actual bytes.
      let forged = zip_patch(
        zip_patch(source, descriptor + 4, 123, 4),
        p + 16,
        123,
        4,
      )
      assert_true(zip_rejects(forged))
      // Consistent size forgery still fails against actual inflated length.
      let forged_size = zip_patch(
        zip_patch(source, descriptor + 12, 1, 4),
        p + 24,
        1,
        4,
      )
      assert_true(zip_rejects(forged_size))
      tested = true
    }
    p = p + 46 + n + ods_zip_u16(source, p + 30) + ods_zip_u16(source, p + 32)
  }
  assert_true(tested)
}

