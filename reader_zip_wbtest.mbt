///|
fn read_ods_content(data : Bytes) -> String raise OdsError {
  read_ods_content_noticing(data, [])
}

///|
fn zip_rejects(data : Bytes) -> Bool {
  try {
    read_ods_content(data) |> ignore
    false
  } catch {
    Invalid(_) => true
  }
}

///|
fn zip_patch(data : Bytes, at : Int32, value : Int32, width : Int32) -> Bytes {
  let out = @buffer.Buffer()
  out.write_bytes(data[:at])
  for i in 0..<width {
    out.write_byte(((value >> (i * 8)) & 255).to_byte())
  }
  out.write_bytes(data[at + width:])
  out.to_bytes()
}

///|
fn zip_sample() -> Bytes raise OdsError {
  stored_package([
    ("mimetype", @utf8.encode(media_type[:])),
    ("content.xml", b"<xml/>"),
  ])
}

///|
test "stable LibreOffice empty UI directories are bounded and never interpreted" {
  for
    name in [
      "Configurations2/", "Configurations2/toolpanel/", "Configurations2/floater/",
      "Configurations2/statusbar/", "Configurations2/toolbar/", "Configurations2/progressbar/",
      "Configurations2/popupmenu/", "Configurations2/menubar/", "Configurations2/images/Bitmaps/",
      "Configurations2/accelerator/current.xml",
    ] {
    let files = [
      ("mimetype", @utf8.encode(media_type[:])),
      ("content.xml", b"<xml/>"),
      (name, b""),
    ]
    let notices : Array[String] = []
    assert_eq(
      read_ods_content_noticing(stored_package(files), notices),
      "<xml/>",
    )
    if name != "Configurations2/" {
      assert_true(notices.contains(name))
    }
    assert_true(
      zip_rejects(
        stored_package([
          ("mimetype", @utf8.encode(media_type[:])),
          ("content.xml", b"<xml/>"),
          (name, b"unexpected content"),
        ]),
      ),
    )
  }
  for
    name in [
      "Configurations2/unknown/", "Configurations2/../", "Configurations2/toolbar/code.xml",
      "Basic/", "Configurations2/images/Bitmaps/payload.png", "Configurations2/accelerator/other.xml",
      "Configurations2/accelerator/../current.xml", "Configurations2/accelerator/Current.xml",
    ] {
    assert_true(
      zip_rejects(
        stored_package([
          ("mimetype", @utf8.encode(media_type[:])),
          ("content.xml", b"<xml/>"),
          (name, b""),
        ]),
      ),
    )
  }
}

///|
test "ZIP reader stored package and mimetype requirements" {
  assert_eq(read_ods_content(zip_sample()), "<xml/>")
  assert_true(zip_rejects(stored_package([("content.xml", b"<xml/>")])))
  assert_true(
    zip_rejects(stored_package([("mimetype", b"wrong"), ("content.xml", b"x")])),
  )
  assert_true(
    zip_rejects(stored_package([("mimetype", @utf8.encode(media_type[:]))])),
  )
  assert_true(
    zip_rejects(
      stored_package([
        ("mimetype", @utf8.encode(media_type[:])),
        ("content.xml", b"x"),
        ("content.xml", b"y"),
      ]),
    ),
  )
}

///|
test "ZIP reader rejects corrupt headers sizes flags CRC and truncation" {
  let data = zip_sample()
  let end = data.length() - 22
  let cd = ods_zip_size(data, end + 16)
  assert_true(zip_rejects(zip_patch(data, cd + 16, 123, 4)))
  assert_true(zip_rejects(zip_patch(data, 38, 65, 1)))
  assert_true(zip_rejects(zip_patch(data, cd + 24, 1, 4)))
  assert_true(zip_rejects(zip_patch(data, cd + 20, -1, 4)))
  assert_true(zip_rejects(zip_patch(data, cd + 6, 45, 2)))
  assert_true(zip_rejects(zip_patch(data, cd + 8, 1, 2)))
  assert_true(zip_rejects(zip_patch(data, cd + 8, 16, 2)))
  assert_true(zip_rejects(zip_patch(data, cd + 10, 12, 2)))
  assert_true(zip_rejects(zip_patch(data, end + 4, 1, 2)))
  assert_true(zip_rejects(zip_patch(data, end + 10, 129, 2)))
  assert_true(zip_rejects(zip_patch(data, end + 16, -1, 4)))
  for n in [0, 1, 21, 30, data.length() - 1] {
    assert_true(zip_rejects(data[:n].to_owned()))
  }
  assert_true(zip_rejects(Bytes::make(33554433, b'\x00')))
}

///|
test "streaming inflate enforces actual byte budget before append" {
  let raw = Bytes::make(4194305, b'a')
  let compressed = @flate.deflate_all(raw)
  assert_true(
    try {
      ods_zip_inflate(compressed, 4194304) |> ignore
      false
    } catch {
      Invalid(_) => true
    },
  )
  let exact = @flate.deflate_all(b"hello")
  assert_eq(ods_zip_inflate(exact, 5), b"hello")
  assert_true(
    try {
      ods_zip_inflate(exact, 4) |> ignore
      false
    } catch {
      Invalid(_) => true
    },
  )
  assert_true(
    try {
      ods_zip_inflate(exact[:exact.length() - 1].to_owned(), 5) |> ignore
      false
    } catch {
      Invalid(_) => true
    },
  )
  assert_true(
    try {
      ods_zip_inflate(b"\x07", 5) |> ignore
      false
    } catch {
      Invalid(_) => true
    },
  )
}

